# 复制成 .env 后按自己的环境改
# cp .env.example .env

APP_NAME=我的 API
DEBUG=true
LOG_LEVEL=INFO

# 本地开发走隧道 15432；容器内用 compose 里的 DATABASE_URL 覆盖
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:15432/postgres?connect_timeout=5


# 阿里百炼（OpenAI 兼容模式）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus